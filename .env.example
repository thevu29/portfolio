# Contact details shown on the site, in the PDF CV and in the link preview.
# Copy to .env (or set them in Vercel → Project → Settings → Environment
# Variables), then rebuild: pages are static, values are read at build time.
CONTACT_EMAIL=
GITHUB_URL=
LINKEDIN_URL=

# Public origin of the site (metadata, sitemap, PDF "Portfolio" link).
# Optional: on Vercel it falls back to the production domain.
NEXT_PUBLIC_SITE_URL=
